# Live USB image: a published Tamarack OS image made bootable from a USB
# stick or DVD without installing. Built in CI and packed into an ISO by
# Titanoboa (see .github/workflows/build-disk.yml). Needs:
#   podman build --cap-add sys_admin --security-opt label=disable \
#     --build-arg BASE_IMAGE=ghcr.io/brecken321/tamarack-os:stable live/
ARG BASE_IMAGE=ghcr.io/brecken321/tamarack-os:stable

FROM ${BASE_IMAGE}
RUN --mount=type=bind,source=.,target=/src bash /src/build.sh
