# Image build parameters (read by the Justfile and CI workflows).
# Image names and registry must match [image] in branding/brand.toml;
# tests/test_config.py enforces this.

IMAGE_VENDOR=brecken321
IMAGE_REGISTRY=ghcr.io/brecken321
IMAGE_DESC="Tamarack OS: an ad-free, privacy-respecting, gaming-ready KDE desktop built on Bazzite"
IMAGE_KEYWORDS="bootc,oci,linux,kde,gaming,bazzite,tamarack"
DEFAULT_TAG=stable
BIB_IMAGE=quay.io/centos-bootc/bootc-image-builder:latest

# Hardware variants: <flavor> -> image name and Bazzite base image.
IMAGE_MAIN=tamarack-os
BASE_MAIN=ghcr.io/ublue-os/bazzite:stable
IMAGE_NVIDIA=tamarack-os-nvidia
BASE_NVIDIA=ghcr.io/ublue-os/bazzite-nvidia-open:stable
# NVIDIA's proprietary driver, for cards older than Turing (GTX 900/1000 series).
IMAGE_NVIDIA_LEGACY=tamarack-os-nvidia-legacy
BASE_NVIDIA_LEGACY=ghcr.io/ublue-os/bazzite-nvidia:stable
